PORT=5000
NODE_ENV=development

# Database MySQL - RecyNect
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Default XAMPP / Laragon (password kosong):
DATABASE_URL="mysql://root:@localhost:3306/RecyNect"

# Jika MySQL lokal Anda memakai password, sesuaikan:
# DATABASE_URL="mysql://root:password123@localhost:3306/RecyNect"

JWT_SECRET="super-secret-key-recy-nect-production-change-later"
