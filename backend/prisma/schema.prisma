// Prisma Schema untuk RecyNect
// Database Engine: MySQL
// Menampung 10 Pilar Fitur Utama (Direktori Pengelola, Info Sampah, Info Harga,
// Minimum Setoran, Perbandingan Harga, Multi-Input Sampah, Matching Persyaratan,
// Optimasi Multi-Pengelola, Ranking Multi-Kriteria, dan Dashboard Pengelola/Admin)

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum ManagementType {
  bank_sampah
  pengepul
  tps3r
  recycler_industry
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum Priority {
  balanced
  highest_value
  nearest
  fewest_stops
}

enum UserRole {
  user
  recycler
  admin
}

// ==========================================
// 1. Akun Pengguna / Masyarakat / Pengelola
// ==========================================
model User {
  id               String            @id @default(uuid())
  name             String            @db.VarChar(100)
  email            String            @unique @db.VarChar(191)
  password         String            @db.VarChar(255)
  phone            String?           @db.VarChar(30)
  role             UserRole          @default(user)
  authVersion      Int               @default(0) @map("auth_version")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  recyclers        Recycler[]
  matchingSessions MatchingSession[]

  @@map("users")
}

// ==========================================
// 2. Akun Internal Staff / Administrator
// (Terpisah secara fisik untuk keamanan operasional)
// ==========================================
model Admin {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(255)
  role      String   @default("admin") @db.VarChar(50) // superadmin, moderator, auditor
  authVersion Int    @default(0) @map("auth_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

// ==========================================
// 3. Profil Pengelola Sampah (Direktori & Dashboard Mitra)
// (Fitur: Direktori Pengelola, Dashboard Pengelola)
// ==========================================
model Recycler {
  id                 String             @id @default(uuid())
  userId             String?            @map("user_id") // Terhubung ke akun pengguna jika mengelola via dashboard
  name               String             @db.VarChar(150)
  managementType     ManagementType     @map("management_type")
  description        String?            @db.Text
  address            String             @db.Text
  latitude           Decimal            @db.Decimal(10, 7)
  longitude          Decimal            @db.Decimal(10, 7)
  contact            String             @db.VarChar(50)
  operatingHours     String?            @map("operating_hours") @db.VarChar(150)
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  isDemo             Boolean            @default(false) @map("is_demo")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  materials          RecyclerMaterial[]

  @@map("recyclers")
}

// ==========================================
// 4. Master Kategori Sampah Daur Ulang
// (Fitur: Informasi Jenis Sampah)
// ==========================================
model WasteCategory {
  id          String             @id @default(uuid())
  name        String             @db.VarChar(100)
  slug        String?            @unique @db.VarChar(100)
  unit        String             @db.VarChar(20) // kg, liter, pcs
  description String?            @db.Text
  icon        String?            @db.VarChar(255)
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  materials   RecyclerMaterial[]
  items       MatchingItem[]

  @@map("waste_categories")
}

// ==========================================
// 5. Ketentuan Material & Harga Mitra
// (Fitur: Informasi Harga, Minimum Setoran, Syarat Mutu, Perbandingan Harga)
// ==========================================
model RecyclerMaterial {
  id                  String               @id @default(uuid())
  recyclerId          String               @map("recycler_id")
  categoryId          String               @map("category_id")
  price               Decimal              @db.Decimal(12, 2) // Harga per satuan unit
  unit                String               @db.VarChar(20)
  minQuantity         Decimal              @default(0) @map("min_quantity") @db.Decimal(8, 2) // Minimum setoran
  qualityRequirements String?              @map("quality_requirements") @db.Text // Syarat mutu (bersih, kering, pilah)
  isAvailable         Boolean              @default(true) @map("is_available")
  priceUpdatedAt      DateTime             @default(now()) @map("price_updated_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  recycler            Recycler             @relation(fields: [recyclerId], references: [id], onDelete: Cascade)
  category            WasteCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceHistories      PriceHistory[]
  assignments         MatchingAssignment[]

  @@unique([recyclerId, categoryId])
  @@map("recycler_materials")
}

// ==========================================
// 6. Sesi Pencocokan (Matching Session)
// (Fitur: Input Multi-Material, Prioritas Ranking, Lokasi Pengguna)
// ==========================================
model MatchingSession {
  id           String           @id @default(uuid())
  userId       String?          @map("user_id") // Nullable untuk pencarian tanpa login (guest)
  latitude     Decimal          @db.Decimal(10, 7)
  longitude    Decimal          @db.Decimal(10, 7)
  priority     Priority         @default(balanced) // Ranking kriteria
  searchRadius Decimal          @default(30.00) @map("search_radius") @db.Decimal(6, 2) // Radius pencarian (km)
  status       String           @default("completed") @db.VarChar(50)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        MatchingItem[]
  results      MatchingResult[]

  @@map("matching_sessions")
}

// ==========================================
// 7. Item Sampah Input Sesi (Maksimal 5 Jenis)
// (Fitur: Input Beberapa Jenis Sampah Sekaligus)
// ==========================================
model MatchingItem {
  id          String               @id @default(uuid())
  sessionId   String               @map("session_id")
  categoryId  String               @map("category_id")
  quantity    Decimal              @db.Decimal(8, 2)
  unit        String               @db.VarChar(20)
  condition   String?              @db.Text // Catatan kondisi dari pengguna
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  session     MatchingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category    WasteCategory        @relation(fields: [categoryId], references: [id])
  assignments MatchingAssignment[]

  @@map("matching_items")
}

// ==========================================
// 8. Alternatif Hasil Rekomendasi (Rank 1, 2, dst)
// (Fitur: Optimasi Kombinasi Multi-Pengelola & Ranking Multi-Kriteria)
// ==========================================
model MatchingResult {
  id               String               @id @default(uuid())
  sessionId        String               @map("session_id")
  rank             Int
  totalValue       Decimal              @map("total_value") @db.Decimal(12, 2) // Total estimasi rupiah
  totalDistance    Decimal              @map("total_distance") @db.Decimal(8, 2) // Total jarak tempuh (km)
  totalStops       Int                  @map("total_stops") // Jumlah lokasi pengelola yang dikunjungi
  economyScore     Decimal              @map("economy_score") @db.Decimal(5, 2)
  distanceScore    Decimal              @map("distance_score") @db.Decimal(5, 2)
  stopsScore       Decimal              @map("stops_score") @db.Decimal(5, 2)
  finalScore       Decimal              @map("final_score") @db.Decimal(5, 2)
  unmatchedSummary String?              @map("unmatched_summary") @db.Text // Rincian material yang belum tertampung
  createdAt        DateTime             @default(now()) @map("created_at")

  session          MatchingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignments      MatchingAssignment[]

  @@map("matching_results")
}

// ==========================================
// 9. Snapshot Penempatan Material ke Pengelola
// (Fitur: Transparansi Harga & Breakdown Rekomendasi)
// ==========================================
model MatchingAssignment {
  id                 String           @id @default(uuid())
  resultId           String           @map("result_id")
  matchingItemId     String           @map("matching_item_id")
  recyclerMaterialId String           @map("recycler_material_id")
  quantitySnapshot   Decimal          @map("quantity_snapshot") @db.Decimal(8, 2)
  priceSnapshot      Decimal          @map("price_snapshot") @db.Decimal(12, 2)
  estimatedValue     Decimal          @map("estimated_value") @db.Decimal(12, 2)
  createdAt          DateTime         @default(now()) @map("created_at")

  result             MatchingResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  matchingItem       MatchingItem     @relation(fields: [matchingItemId], references: [id])
  recyclerMaterial   RecyclerMaterial @relation(fields: [recyclerMaterialId], references: [id])

  @@map("matching_assignments")
}

// ==========================================
// 10. Audit Riwayat Perubahan Harga
// (Fitur: Transparansi & Pantauan Harga Usang)
// ==========================================
model PriceHistory {
  id                 String           @id @default(uuid())
  recyclerMaterialId String           @map("recycler_material_id")
  oldPrice           Decimal          @map("old_price") @db.Decimal(12, 2)
  newPrice           Decimal          @map("new_price") @db.Decimal(12, 2)
  changedAt          DateTime         @default(now()) @map("changed_at")

  recyclerMaterial   RecyclerMaterial @relation(fields: [recyclerMaterialId], references: [id], onDelete: Cascade)

  @@map("price_histories")
}
