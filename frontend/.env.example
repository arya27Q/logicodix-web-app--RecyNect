# ==========================================
# RECYNECT FRONTEND ENVIRONMENT CONFIGURATION
# ==========================================

# URL Base API di sisi Client (Browser)
# Gunakan '/api' agar request diteruskan via Next.js rewrites (First-party Cookie)
# Di lokal: /api (atau http://localhost:5000/api)
# Di Hostinger: /api
NEXT_PUBLIC_API_URL="/api"

# URL Backend Express (Server-Side Only - TIDAK diexpose ke browser)
# Digunakan oleh Next.js rewrites (next.config.ts) & SSR server-auth
# Di lokal: http://localhost:5000
# Di Hostinger: https://royalblue-echidna-840805.hostingersite.com
BACKEND_URL="https://royalblue-echidna-840805.hostingersite.com"
