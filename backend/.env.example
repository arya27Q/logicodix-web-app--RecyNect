PORT=5000
NODE_ENV=development

# Use a dedicated database account with limited permissions.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/RecyNect"

# Generate a unique secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
FRONTEND_ORIGINS=http://localhost:3000
# Set only when the frontend and API use subdomains of the same site.
# COOKIE_DOMAIN=.example.com

# Only used by the destructive development seed after setting RESET_DATABASE=true.
RESET_DATABASE=false
SEED_USER_PASSWORD=
SEED_RECYCLER_PASSWORD=
SEED_ADMIN_PASSWORD=

# Set these locally before running npm run admin:create. Never commit the values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
