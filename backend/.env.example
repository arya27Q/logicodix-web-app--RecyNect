# ==========================================
# RECYNECT BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Port backend (Hostinger / VPS / PM2)
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection String
# Port 6543 (Transaction Pooler dengan pgbouncer=true) untuk query aplikasi
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Port 5432 (Direct Connection) untuk migration & Prisma CLI
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Secret acak minimal 32 karakter untuk hashing token JWT & session
# Buat dengan: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="ganti_dengan_random_secret_minimal_32_karakter_bebas"

# Origin frontend yang diizinkan CORS (pisahkan dengan koma tanpa trailing slash)
FRONTEND_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Opsional: Jika frontend dan backend berbagi root domain yang sama (misal api.domain.com & domain.com)
# COOKIE_DOMAIN=.yourdomain.com
