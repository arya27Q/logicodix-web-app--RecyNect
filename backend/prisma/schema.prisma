// Prisma Schema untuk SampahHub
// Arsitektur Pemisahan Fisik Akun (Public Users vs Internal Admins vs Partner Recyclers)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ManagementType {
  bank_sampah
  pengepul
  tps3r
  recycler_industry
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum Priority {
  balanced
  highest_value
  nearest
  fewest_stops
}

// 1. Akun Masyarakat / Warga (Public User)
model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  matchingSessions MatchingSession[]

  @@map("users")
}

// 2. Akun Internal Staff / Administrator (Terpisah Fisik - Tanpa Registrasi Publik)
model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin") // superadmin, moderator, auditor
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

// 3. Profil Mitra Pengelola Sampah (Bank Sampah, Pengepul, TPS3R, Industri)
model Recycler {
  id                 String             @id @default(uuid())
  name               String
  managementType     ManagementType     @map("management_type")
  address            String
  latitude           Decimal            @db.Decimal(10, 7)
  longitude          Decimal            @db.Decimal(10, 7)
  contact            String
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  isDemo             Boolean            @default(false) @map("is_demo")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  materials          RecyclerMaterial[]

  @@map("recyclers")
}

// 4. Master Kategori Sampah Daur Ulang
model WasteCategory {
  id          String             @id @default(uuid())
  name        String
  unit        String             // kg, liter, pcs, etc.
  description String?
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  materials   RecyclerMaterial[]
  items       MatchingItem[]

  @@map("waste_categories")
}

// 5. Ketentuan Penerimaan Material oleh Pengelola
model RecyclerMaterial {
  id                  String               @id @default(uuid())
  recyclerId          String               @map("recycler_id")
  categoryId          String               @map("category_id")
  price               Decimal              @db.Decimal(12, 2)
  unit                String
  minQuantity         Decimal              @default(0) @map("min_quantity") @db.Decimal(8, 2)
  qualityRequirements String?              @map("quality_requirements")
  isAvailable         Boolean              @default(true) @map("is_available")
  priceUpdatedAt      DateTime             @default(now()) @map("price_updated_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  recycler            Recycler             @relation(fields: [recyclerId], references: [id], onDelete: Cascade)
  category            WasteCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceHistories      PriceHistory[]
  assignments         MatchingAssignment[]

  @@unique([recyclerId, categoryId])
  @@map("recycler_materials")
}

// 6. Sesi Pencocokan (Bisa Guest user_id = null, atau Logged in user)
model MatchingSession {
  id           String           @id @default(uuid())
  userId       String?          @map("user_id") // Nullable untuk pencarian tamu publik
  latitude     Decimal          @db.Decimal(10, 7)
  longitude    Decimal          @db.Decimal(10, 7)
  priority     Priority         @default(balanced)
  searchRadius Decimal          @default(30) @map("search_radius") @db.Decimal(6, 2)
  status       String           @default("completed")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user         User?            @relation(fields: [userId], references: [id])
  items        MatchingItem[]
  results      MatchingResult[]

  @@map("matching_sessions")
}

// 7. Item Sampah yang Dimasukkan pada Satu Sesi (Maksimal 5)
model MatchingItem {
  id          String               @id @default(uuid())
  sessionId   String               @map("session_id")
  categoryId  String               @map("category_id")
  quantity    Decimal              @db.Decimal(8, 2)
  unit        String
  condition   String?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  session     MatchingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category    WasteCategory        @relation(fields: [categoryId], references: [id])
  assignments MatchingAssignment[]

  @@map("matching_items")
}

// 8. Alternatif Hasil Rekomendasi (Rank 1, 2, dst)
model MatchingResult {
  id               String               @id @default(uuid())
  sessionId        String               @map("session_id")
  rank             Int
  totalValue       Decimal              @map("total_value") @db.Decimal(12, 2)
  totalDistance    Decimal              @map("total_distance") @db.Decimal(8, 2)
  totalStops       Int                  @map("total_stops")
  economyScore     Decimal              @map("economy_score") @db.Decimal(5, 2)
  distanceScore    Decimal              @map("distance_score") @db.Decimal(5, 2)
  stopsScore       Decimal              @map("stops_score") @db.Decimal(5, 2)
  finalScore       Decimal              @map("final_score") @db.Decimal(5, 2)
  unmatchedSummary String?              @map("unmatched_summary")
  createdAt        DateTime             @default(now()) @map("created_at")

  session          MatchingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignments      MatchingAssignment[]

  @@map("matching_results")
}

// 9. Snapshot Penempatan Material ke Pengelola Tertentu
model MatchingAssignment {
  id                 String           @id @default(uuid())
  resultId           String           @map("result_id")
  matchingItemId     String           @map("matching_item_id")
  recyclerMaterialId String           @map("recycler_material_id")
  quantitySnapshot   Decimal          @map("quantity_snapshot") @db.Decimal(8, 2)
  priceSnapshot      Decimal          @map("price_snapshot") @db.Decimal(12, 2)
  estimatedValue     Decimal          @map("estimated_value") @db.Decimal(12, 2)
  createdAt          DateTime         @default(now()) @map("created_at")

  result             MatchingResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  matchingItem       MatchingItem     @relation(fields: [matchingItemId], references: [id])
  recyclerMaterial   RecyclerMaterial @relation(fields: [recyclerMaterialId], references: [id])

  @@map("matching_assignments")
}

// 10. Audit Riwayat Perubahan Harga
model PriceHistory {
  id                 String           @id @default(uuid())
  recyclerMaterialId String           @map("recycler_material_id")
  oldPrice           Decimal          @map("old_price") @db.Decimal(12, 2)
  newPrice           Decimal          @map("new_price") @db.Decimal(12, 2)
  changedAt          DateTime         @default(now()) @map("changed_at")

  recyclerMaterial   RecyclerMaterial @relation(fields: [recyclerMaterialId], references: [id], onDelete: Cascade)

  @@map("price_histories")
}
